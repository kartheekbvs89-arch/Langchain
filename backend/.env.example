# Enterprise Knowledge Assistant — backend environment
# Copy this file to .env and edit values as needed.

# --- App ---
APP_NAME="Enterprise Knowledge Assistant"
APP_VERSION=2.0.0
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS="http://localhost:8000,http://localhost:5500,http://127.0.0.1:8000,https://kartheekbvs89-arch.github.io"

# --- Vector DB ---
VECTOR_DB_PATH="./data/chroma_db"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384
COLLECTION_PREFIX=eka_

# --- RAG retrieval ---
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- LLM (optional — leave empty to use local TemplateLLM) ---
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# --- Agents ---
ENABLED_AGENTS=hr,it,policy

# --- Analytics ---
ENABLE_ANALYTICS=true
